{
  "name": "bstack",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.8.0",
      "@bogeychan/elysia-logger": "^0.1.10",
      "@elysia/cors": "^1.4.2",
      "@elysia/eden": "^1.4.10",
      "@elysia/openapi": "^1.4.16",
      "@fontsource-variable/geist": "^5.3.0",
      "@playwright/test": "^1.63.0",
      "@shadcn/lint": "^0.2.0",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-query": "^5.104.1",
      "@tanstack/react-query-devtools": "^5.104.1",
      "@tanstack/react-router": "^1.170.41",
      "@tanstack/react-router-devtools": "^1.167.2",
      "@tanstack/router-plugin": "^1.168.42",
      "@types/bun": "^1.4.2",
      "@types/node": "^26.6.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.4.0",
      "drizzle-kit": "^1.0.0-rc.4",
      "drizzle-orm": "^1.0.0-rc.4",
      "elysia": "latest",
      "es-toolkit": "^1.52.0",
      "knip": "^6.40.0",
      "lucide-react": "^1.52.0",
      "next-themes": "^0.4.6",
      "oxc-transform-react": "^0.153.0",
      "pino-pretty": "^13.2.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "shadcn": "^4.21.3",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "^7.0.2",
      "ultracite": "^7.12.4",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
      "vite-plus": "1.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "ready": "vp check && vp run knip && vp test && vp run test:e2e && vp run -r build",
    "prepare": "vp config",
    "test:e2e": "vp run --filter @bstack/web test:e2e",
    "knip": "knip"
  },
  "devDependencies": {
    "@bstack/config": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    }
  },
  "trustedDependencies": [
    "vite-plus"
  ]
}
